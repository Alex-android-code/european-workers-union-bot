# Staging artifact only. This file is not selected by railway.toml or production Dockerfile.
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 EWU_V2_ENABLED=0
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY bot.py ./
COPY privacy/__init__.py privacy/onboarding.py privacy/ui.json ./privacy/
COPY ewu ./ewu
COPY migrations ./migrations
COPY tests ./tests
COPY scripts ./scripts
COPY vacancies ./vacancies
RUN useradd --uid 10001 --create-home ewu
USER ewu
# Safe default: synthetic Python verification, not a Telegram consumer.
CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py"]
