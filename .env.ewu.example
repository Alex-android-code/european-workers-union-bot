# Names only. Keep real values in Railway or a private file, never git.
RAILWAY_DOCKERFILE_PATH=Dockerfile.ewu
TELEGRAM_TOKEN=
EWU_START_ALLOWED=0
EWU_MAINTENANCE=1
PRIVACY_CONFIG_FILE=/data/ewu/privacy.local.json
# Or a private Railway JSON variable, never committed with real contents.
PRIVACY_CONFIG_JSON=
PRIVACY_DB_PATH=/data/ewu/privacy.sqlite3
EWU_ADMIN_IDS=
# The legacy CRM_ENABLED/GOOGLE_SCRIPT_URL are deliberately ignored by v2.
CRM_V2_ENABLED=0
CRM_V2_REVIEWED=0
CRM_V2_URL=
CRM_V2_SECRET=
CRM_V2_SHEET_ID=YOUR_PRIVATE_SHEET_ID
