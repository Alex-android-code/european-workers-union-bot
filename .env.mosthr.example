# Optional bridge. Existing bot variables are still required; no credentials belong in Git.
MOSTHR_ENABLED=false
MOSTHR_URL=https://your-mosthr-staging.example
# Same new random >=32-character key as MostHR EWU_BRIDGE_KEY.
MOSTHR_BRIDGE_KEY=
# A separate stable random >=32-character secret for per-vacancy candidate pseudonyms.
# Keep it when rotating the API key. Never reuse TELEGRAM_TOKEN here.
MOSTHR_SUBJECT_SECRET=
